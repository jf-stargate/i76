{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I76 research findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(i76exe|i76edit|shared)-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "claim",
          "status",
          "confidence",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 8
          },
          "status": {
            "enum": [
              "proven",
              "derived",
              "inferred",
              "unresolved",
              "contradicted"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "scope": {
            "enum": [
              "editor",
              "game",
              "shared"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "reference"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    }
  }
}

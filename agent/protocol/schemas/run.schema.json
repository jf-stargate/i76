{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I76 run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "track",
    "topic",
    "protocol_version",
    "base_commit",
    "started_at",
    "inputs",
    "baselines",
    "artifacts",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(i76exe|i76edit|shared)-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "track": {
      "enum": [
        "i76exe",
        "i76edit",
        "shared"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(artifacts|evidence|scripts)/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "test_count",
        "passed_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "partial",
            "failed",
            "not-run"
          ]
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I76 research-grade run record v1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "run_id",
    "track",
    "topic",
    "base_commit",
    "started_at",
    "inputs",
    "baselines",
    "artifacts",
    "validation",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(i76exe|i76edit|i76shell|shared)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "track": {
      "enum": [
        "i76exe",
        "i76edit",
        "i76shell",
        "shared"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "md5",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "retail-executable",
              "editor-executable",
              "resource-manifest",
              "other",
              "shell-dll"
            ]
          },
          "md5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "program_name",
          "baseline_id",
          "baseline_sha256"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "program_name": {
            "type": "string",
            "minLength": 1
          },
          "baseline_id": {
            "type": "string",
            "minLength": 1
          },
          "baseline_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "storage_ref": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(artifacts|evidence|scripts)/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "kind": {
            "enum": [
              "assembly",
              "decompilation",
              "report",
              "script",
              "table",
              "test-result",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "test_count",
        "passed_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "partial",
            "failed",
            "not-run"
          ]
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "script_refs",
        "methods",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "script_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "git-blob",
                  "run-artifact",
                  "retail-address",
                  "script",
                  "test",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "address": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "const": "i76exe"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "minItems": 1
          },
          "baselines": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "i76edit"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "minItems": 1
          },
          "baselines": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "track"
        ],
        "properties": {
          "track": {
            "const": "i76shell"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "shell-dll"
                }
              }
            },
            "minContains": 1
          },
          "baselines": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
